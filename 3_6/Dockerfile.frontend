FROM ubuntu
WORKDIR /usr/app/src
COPY code/example-frontend .
ENV REACT_APP_BACKEND_URL=http://127.0.0.1:8080

RUN apt-get update && apt-get install -y curl && curl -sL https://deb.nodesource.com/setup_16.x | bash && apt install -y nodejs && npm install && npm run build && npm install -g serve && apt-get purge -y --auto-remove curl && rm -rf /var/lib/apt/lists/* && rm -rf src && useradd -m appuser &&chown appuser .
EXPOSE 5001
USER appuser

CMD ["serve", "-s", "-l", "5001", "build"]
